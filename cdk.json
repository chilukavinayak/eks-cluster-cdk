{
  "app": "npx ts-node --prefer-ts-exts src/app.ts",
  "watch": {
    "include": ["**"],
    "exclude": ["README.md", "cdk*.json", "**/*.d.ts", "**/*.js", "tsconfig.json", "package*.json", "yarn.lock", "node_modules", "test"]
  },
  "context": {
    "@aws-cdk/core:stackRelativeExports": true,
    "@aws-cdk/aws-ecr-assets:dockerIgnoreSupport": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true,
    "@aws-cdk/aws-sns-subscriptions:restrictSqsDescryption": true,
    "@aws-cdk/aws-apigateway:disableCloudWatchRole": true,
    "@aws-cdk/core:target-partitions": ["aws", "aws-cn"],
    "@aws-cdk/aws-eks:cluster-logging": true,
    "@aws-cdk/aws-eks:prune-cluster-handler-log-retention": true,
    "@aws-cdk/aws-eks:patch-kubectl-lambda-runtime": true,
    "@aws-cdk/aws-eks:kubectl-layer": true
  }
}
