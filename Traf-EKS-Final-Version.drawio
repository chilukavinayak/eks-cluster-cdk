        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    subgraph EKS[\&quot;EKS Cluster - OneDesk\&quot;]\n        subgraph SystemNS[\&quot;System Namespaces\&quot;]\n            kube[\&quot;kube-system\&quot;]\n            ingress[\&quot;ingress-nginx\&quot;]\n            monitoring[\&quot;monitoring\&quot;]\n            secrets[\&quot;external-secrets\&quot;]\n        end\n\n        subgraph AlphaNS[\&quot;Alpha Environment\&quot;]\n            subgraph alpha-ui[\&quot;alpha-ui namespace\&quot;]\n                a_ui1[\&quot;ui-pod-1\&quot;]\n                a_ui2[\&quot;ui-pod-2\&quot;]\n                a_ui_sa[\&quot;ServiceAccount:\\nalpha-ui-sa\&quot;]\n            end\n            subgraph alpha-query[\&quot;alpha-query namespace\&quot;]\n                a_q1[\&quot;query-pod-1\&quot;]\n                a_q2[\&quot;query-pod-2\&quot;]\n                a_query_sa[\&quot;ServiceAccount:\\nalpha-query-sa\&quot;]\n            end\n            subgraph alpha-command[\&quot;alpha-command namespace\&quot;]\n                a_c1[\&quot;command-pod-1\&quot;]\n                a_c2[\&quot;command-pod-2\&quot;]\n                a_cmd_sa[\&quot;ServiceAccount:\\nalpha-command-sa\&quot;]\n            end\n        end\n\n        subgraph BetaNS[\&quot;Beta Environment\&quot;]\n            subgraph beta-ui[\&quot;beta-ui namespace\&quot;]\n                b_ui[\&quot;ui-pods\&quot;]\n            end\n            subgraph beta-query[\&quot;beta-query namespace\&quot;]\n                b_q[\&quot;query-pods\&quot;]\n            end\n            subgraph beta-command[\&quot;beta-command namespace\&quot;]\n                b_c[\&quot;command-pods\&quot;]\n            end\n        end\n\n        subgraph GammaNS[\&quot;Gamma Environment\&quot;]\n            subgraph gamma-ui[\&quot;gamma-ui namespace\&quot;]\n                g_ui[\&quot;ui-pods\&quot;]\n            end\n            subgraph gamma-query[\&quot;gamma-query namespace\&quot;]\n      