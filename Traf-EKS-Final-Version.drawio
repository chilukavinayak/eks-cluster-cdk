        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    subgraph EKS[\&quot;EKS Cluster - Private Subnets\&quot;]\n        subgraph QueryNS[\&quot;query namespace\&quot;]\n            QueryPod[\&quot;Query Pod\&quot;]\n            QuerySA[\&quot;ServiceAccount\\n+ IRSA\&quot;]\n        end\n        subgraph CmdNS[\&quot;command namespace\&quot;]\n            CmdPod[\&quot;Command Pod\&quot;]\n            CmdSA[\&quot;ServiceAccount\\n+ IRSA\&quot;]\n        end\n    end\n\n    subgraph DataLayer[\&quot;Data Subnet - Isolated\&quot;]\n        subgraph RDS[\&quot;Amazon RDS\&quot;]\n            Primary[\&quot;Primary Instance\\nAZ-A\&quot;]\n            Standby[\&quot;Standby Instance\\nAZ-B\&quot;]\n            ReadReplica[\&quot;Read Replica\\nAZ-C\&quot;]\n        end\n        \n        subgraph RDSConfig[\&quot;RDS Configuration\&quot;]\n            Encryption[\&quot;✅ Encryption at Rest\\n(KMS CMK)\&quot;]\n            TLS[\&quot;✅ TLS Enforced\\n(require_ssl=1)\&quot;]\n            NoPublic[\&quot;❌ Public Access\\nDISABLED\&quot;]\n            SG[\&quot;✅ Security Group\\nEKS Pods Only\&quot;]\n        end\n    end\n\n    subgraph Security[\&quot;Security Controls\&quot;]\n        SM[\&quot;🔐 Secrets Manager\\nDB Credentials\&quot;]\n        Pool[\&quot;Connection Pool\\nPgBouncer/ProxySQL\&quot;]\n    end\n\n    QueryPod --&gt;|TLS 5432| Pool\n    CmdPod --&gt;|TLS 5432| Pool\n    Pool --&gt;|TLS| Primary\n    Primary &lt;--&gt;|Sync Replication| Standby\n    Primary --&gt;|Async Replication| ReadReplica\n    QueryPod -.-&gt;|Read Queries| ReadReplica\n    SM -.-&gt;|Inject Credentials| QueryPod &amp; CmdPod\n\n    classDef eks fill:#326CE5,stroke:#fff,color:#fff\n    classDef rds fill:#3b48cc,stroke:#527FFF,color:#fff\n    classDef security fill:#1B5E20,stroke:#4CAF50,color:#fff\n    classDef config fill:#37474F,stroke:#607D8B,color:#fff\n\n    class QueryNS,CmdNS eks\n    class Primary,Standby,ReadReplica rds\n    class SM,Pool security\n    class RDSConfig config&quot;&#xa;}" id="VoKHCigZzPTQo7TD1_WB-30">
