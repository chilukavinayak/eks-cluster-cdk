        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    subgraph EKS[\&quot;EKS Cluster\&quot;]\n        subgraph CommandNS[\&quot;command namespace\&quot;]\n            CmdPod[\&quot;Command Service Pod\&quot;]\n            CmdSA[\&quot;ServiceAccount\\n+ IRSA\&quot;]\n        end\n        subgraph QueryNS[\&quot;query namespace\&quot;]\n            QueryPod[\&quot;Query Service Pod\&quot;]\n            QuerySA[\&quot;ServiceAccount\\n+ IRSA\&quot;]\n        end\n    end\n\n    subgraph SQS[\&quot;Amazon SQS\&quot;]\n        subgraph OrderQueues[\&quot;Order Processing\&quot;]\n            OrderQ[\&quot;order-queue\&quot;]\n            OrderDLQ[\&quot;order-dlq\&quot;]\n        end\n        subgraph PaymentQueues[\&quot;Payment Processing\&quot;]\n            PaymentQ[\&quot;payment-queue\&quot;]\n            PaymentDLQ[\&quot;payment-dlq\&quot;]\n        end\n        subgraph NotificationQueues[\&quot;Notifications\&quot;]\n            NotifyQ[\&quot;notification-queue\&quot;]\n            NotifyDLQ[\&quot;notification-dlq\&quot;]\n        end\n    end\n\n    subgraph IAMPolicies[\&quot;IAM Policies - Scoped Per Service\&quot;]\n        CmdPolicy[\&quot;command-sqs-policy:\\n- sqs:SendMessage → order-queue\\n- sqs:SendMessage → payment-queue\\n❌ No wildcard access\&quot;]\n        QueryPolicy[\&quot;query-sqs-policy:\\n- sqs:ReceiveMessage → order-queue\\n- sqs:DeleteMessage → order-queue\\n❌ No SendMessage\&quot;]\n    end\n\n    subgraph Monitoring[\&quot;CloudWatch Alarms\&quot;]\n        DepthAlarm[\&quot;📊 Queue Depth &gt; 1000\&quot;]\n        AgeAlarm[\&quot;⏱️ Message Age &gt; 5min\&quot;]\n        DLQAlarm[\&quot;🚨 DLQ Messages &gt; 0\&quot;]\n    end\n\n    CmdPod --&gt;|SendMessage| OrderQ &amp; PaymentQ\n    QueryPod --&gt;|ReceiveMessage| OrderQ\n    QueryPod --&gt;|ReceiveMessage| PaymentQ\n    \n    OrderQ --&gt;|After 3 retries| OrderDLQ\n    PaymentQ --&gt;|After 3 retries| PaymentDLQ\n    NotifyQ --&gt;|After 3 retries| NotifyDLQ\n\n    CmdSA -.-&gt; CmdPolicy\n    QuerySA -.-&gt; QueryPolicy\n\n    OrderQ &amp; PaymentQ &amp; NotifyQ -.-&gt; Monitoring\n\n    classDef pod fill:#326CE5,stroke:#fff,color:#fff\n    classDef queue fill:#FF9900,stroke:#232F3E,color:#000\n    classDef dlq fill:#B71C1C,stroke:#F44336,color:#fff\n    classDef policy fill:#1B5E20,stroke:#4CAF50,color:#fff\n\n    class CmdPod,QueryPod pod\n    class OrderQ,PaymentQ,NotifyQ queue\n    class OrderDLQ,PaymentDLQ,NotifyDLQ dlq\n    class CmdPolicy,QueryPolicy policy&quot;&#xa;}" id="W-S9TtZug6BMPziCy5Bv-37">
