        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    participant Pod as Pod/Container\n    participant SA as K8s ServiceAccount\n    participant OIDC as EKS OIDC Provider\n    participant STS as AWS STS\n    participant IAM as IAM Role\n    participant AWS as AWS Service\n\n    Note over Pod,AWS: IRSA Flow - Pod Assumes IAM Role\n\n    Pod-&gt;&gt;SA: Mount ServiceAccount Token\n    SA-&gt;&gt;Pod: JWT Token (OIDC)\n    \n    Pod-&gt;&gt;STS: AssumeRoleWithWebIdentity\n    Note right of Pod: Includes: JWT Token, Role ARN, Session Name\n    \n    STS-&gt;&gt;OIDC: Validate JWT Token\n    OIDC--&gt;&gt;STS: Token Valid + Claims\n    \n    STS-&gt;&gt;IAM: Check Trust Policy\n    Note right of IAM: Verify: - OIDC Provider - Namespace - ServiceAccount\n    IAM--&gt;&gt;STS: Role Allowed\n    \n    STS--&gt;&gt;Pod: Temporary Credentials\n    Note right of Pod: AccessKeyId SecretAccessKey SessionToken Expiration\n    \n    Pod-&gt;&gt;AWS: API Call with Temp Credentials\n    AWS-&gt;&gt;IAM: Validate Permissions\n    IAM--&gt;&gt;AWS: Authorized Actions\n    AWS--&gt;&gt;Pod: API Response&quot;&#xa;}" id="58eIOYSHbkdsNpAyf3Ri-35">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1">
