        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    participant ESO as External Secrets Operator\n    participant SM as AWS Secrets Manager\n    participant K8S as Kubernetes API Server\n    participant Pod as Application Pod\n    participant Lambda as Rotation Lambda\n\n    Note over ESO,Lambda: Initial Secret Sync\n\n    ESO-&gt;&gt;SM: Poll for Secret Value\n    SM--&gt;&gt;ESO: Return Current Secret\n    ESO-&gt;&gt;K8S: Create/Update K8s Secret\n    K8S--&gt;&gt;ESO: Secret Created\n\n    Note over ESO,Lambda: Pod Startup\n\n    Pod-&gt;&gt;K8S: Mount Secret as Volume\n    K8S--&gt;&gt;Pod: Inject Secret Data\n    Pod-&gt;&gt;Pod: Read Credentials from Mounted Volume\n\n    Note over ESO,Lambda: Automated Rotation (Every 30 days)\n\n    Lambda-&gt;&gt;SM: Rotate Credentials\n    SM-&gt;&gt;SM: Generate New Password\n    SM-&gt;&gt;SM: Update DB Password\n    SM--&gt;&gt;Lambda: Rotation Complete\n\n    Note over ESO,Lambda: Secret Refresh (No Downtime)\n\n    ESO-&gt;&gt;SM: Detect Version Change\n    SM--&gt;&gt;ESO: Return New Secret\n    ESO-&gt;&gt;K8S: Update K8s Secret\n    K8S-&gt;&gt;Pod: Signal Volume Update\n    Pod-&gt;&gt;Pod: Reload Credentials (No Restart Required)&quot;&#xa;}" id="n3daCDnfoOg5PPQQNwpt-42">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry y="1360" width="1211.5" height="1255" as="geometry" />
          </mxCell>
