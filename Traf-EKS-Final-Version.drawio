e\n\n    classDef role fill:#0D47A1,stroke:#2196F3,color:#fff\n    classDef sa fill:#1B5E20,stroke:#4CAF50,color:#fff\n    classDef node fill:#B71C1C,stroke:#F44336,color:#fff\n\n    class UIRole,QueryRole,CommandRole role\n    class UI_SA,Query_SA,Cmd_SA sa\n    class NodeRole node&quot;&#xa;}" id="CyuhS1Bhk7pTvkuvQ27w-28">
